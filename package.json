{
  "name": "strongly",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "test": "npm run build && npm run test:unit && npm run test:timezone && npm run test:history-rank && npm run test:week-reflection && npm run test:isolation && npm run test:weekly && npm run test:prestige && npm run test:campaign && npm run test:lifecycle && npm run test:planning-safeguards && npm run test:weekly-milestone && npm run test:master-mode && npm run test:auth-email && npm run test:auth-security",
    "test:unit": "node --test tests/rendered-html.test.mjs",
    "test:isolation": "tsx --test tests/cross-user-isolation.test.ts",
    "test:weekly": "tsx --test tests/weekly-planning.test.ts",
    "test:prestige": "tsx --test tests/prestige.test.ts",
    "test:campaign": "tsx --test tests/campaign-actions.integration.test.ts",
    "test:lifecycle": "tsx --test tests/week-lifecycle.integration.test.ts",
    "test:planning-safeguards": "tsx --test tests/planning-safeguards.integration.test.ts",
    "test:auth-email": "tsx --test tests/auth-email.test.ts",
    "test:auth-security": "tsx --test tests/auth-security.test.ts",
    "test:weekly-milestone": "tsx --test tests/weekly-milestone.integration.test.ts",
    "test:master-mode": "tsx --test tests/master-mode.test.ts",
    "test:timezone": "tsx --test tests/timezones.test.ts",
    "test:week-reflection": "tsx --test tests/week-reflection.test.ts",
    "test:history-rank": "tsx --test tests/history-rank.test.ts",
    "lint": "eslint . --ignore-pattern .next --ignore-pattern dist --ignore-pattern .vite-cache --ignore-pattern .vite-local-cache --ignore-pattern .vite-local-cache-v2 --ignore-pattern .wrangler",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node --env-file-if-exists=.env.local scripts/migrate.mjs"
  },
  "dependencies": {
    "drizzle-orm": "0.45.2",
    "next": "16.3.2",
    "pg": "8.16.3",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/pg": "8.15.6",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "16.3.2",
    "pg-mem": "3.0.5",
    "react-server-dom-webpack": "19.2.8",
    "tailwindcss": "4.2.1",
    "tsx": "4.20.6",
    "typescript": "5.9.3"
  },
  "type": "module"
}
