{
  "name": "strongly",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "test": "npm run build && npm run test:unit && npm run test:isolation && npm run test:weekly && npm run test:prestige",
    "test:unit": "node --test tests/rendered-html.test.mjs",
    "test:isolation": "tsx --test tests/cross-user-isolation.test.ts",
    "test:weekly": "tsx --test tests/weekly-planning.test.ts",
    "test:prestige": "tsx --test tests/prestige.test.ts",
    "lint": "eslint . --ignore-pattern .next --ignore-pattern dist --ignore-pattern .vite-cache --ignore-pattern .vite-local-cache --ignore-pattern .vite-local-cache-v2 --ignore-pattern .wrangler",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node --env-file-if-exists=.env.local scripts/migrate.mjs"
  },
  "dependencies": {
    "drizzle-orm": "0.45.2",
    "next": "16.2.6",
    "pg": "8.16.3",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@types/pg": "8.15.6",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "pg-mem": "3.0.5",
    "react-server-dom-webpack": "19.2.6",
    "tailwindcss": "4.2.1",
    "tsx": "4.20.6",
    "typescript": "5.9.3"
  },
  "type": "module"
}
